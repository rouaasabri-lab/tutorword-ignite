# ---------- WordPress / WooCommerce ----------
# Both URLs MUST point to the same WordPress site.
WP_API_URL=https://your-wp-site.com/wp-json/wp/v2
WC_API_URL=https://your-wp-site.com/wp-json/wc/v3
WC_KEY=ck_your_consumer_key
WC_SECRET=cs_your_consumer_secret

# Numeric WC product IDs of the two subscription products (create them in WP Admin).
# Used when registering an order after a successful Stripe checkout.
WC_PRODUCT_MONTHLY=
WC_PRODUCT_YEARLY=

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_live_xxx_or_sk_test_xxx
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_YEARLY=price_xxx
# From the Stripe webhook endpoint you create (see DEPLOY.md).
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---------- Server ----------
# Public URL the app is served from (used for canonical links, OG tags etc.)
PUBLIC_BASE_URL=https://tutorworld.your-domain.com
PORT=3000
NODE_ENV=production